    @page "/UserTable"
    @* Riservata a te: contiene l'elenco degli utenti registrati *@
    @attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
    @using SharedLibrary.Dto
    @inject HttpClient Http

    <style>
        body {
            background-image: url('images/sfondoadmin.webp');
            background-size: cover;
            background-position: center;
            background-size: 100% auto; /* si adatta in larghezza, mantenendo proporzioni */
            background-repeat: no-repeat;
            background-position: top center;
            background-attachment: fixed; /* effetto scorrimento parallax */
            background-color: black; /* per riempire eventuali bordi */
            min-height: 100vh; /* copre almeno l'altezza visibile */
        }

        .title-users {
            text-align: center;
            color: gold;
            font-family: 'Cinzel', serif;
            font-weight: 700;
            font-size: 3rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.6);
            margin: 2rem 0;
        }

        .not-auth {
            text-align: center;
            color: ghostwhite;
            font-family: 'Cinzel', serif;
            font-weight: 80;
            font-size: 3rem;
            text-transform: uppercase;
            letter-spacing: 4px;
        }

        @@media (max-width: 480px) {

            body {
                background-size: cover;
            }
        }
    </style>


    @* Prima il controllo era "ApplicationManager.Username == \"Admin\"", ma quella
       proprietà non viene MAI assegnata da nessuna parte (l'unico punto che la
       scriveva è commentato in ExistingHunter.razor.cs, da quando c'è Auth0).
       Risultato: la condizione era sempre falsa e la tabella non si vedeva mai.
       Ora usa i ruoli veri di Auth0, come fa già la pagina admin. *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <p class="title-users">Registred Users</p>

            <p style="text-align: center; color: white;">
                Hier is only for Admins to see how much Hunters was registred to this site of Guild Enjoy!
            </p>

            @if (loadError is not null)
            {
                <p style="color: #ff6b6b; text-align: center;">@loadError</p>
            }
            else if (UsersList == null)
            {
                <p style="color: white;"><em>Loading please...</em></p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th style="color: yellow;">Username</th>
                            <th style="color: yellow;">Account</th>
                            <th style="color: yellow;">Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* La colonna Password è stata rimossa: l'API non manda
                           più le password (prima le restituiva in chiaro). *@
                        @foreach (var registered in UsersList)
                        {
                            <tr>
                                <td style="color: lightgrey;">@registered.Username</td>
                                <td style="color: lightgrey;">@registered.Account</td>
                                <td style="color: lightgrey;">@registered.RegistrationDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </Authorized>

        <NotAuthorized>
            <div class="not-auth">
                <p style="text-align: center; color: white;">
                   Sorry you are not authorized
                </p>
            </div>
        </NotAuthorized>
    </AuthorizeView>