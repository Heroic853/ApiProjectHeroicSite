@page "/mhxr-feedback"
@using SharedLibrary.Dto

<PageTitle>MHXR Feedback — Heroic853</PageTitle>

<style>
    body {
        background-image: url('images/WallpaperMHXR.png');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: top center;
        background-attachment: fixed;
        background-color: #0d0500;
        min-height: 100vh;
    }

    .mhxr-wrap {
        max-width: 680px;
        margin: 0 auto;
        padding: 40px 18px 70px;
    }

    /* ---- Intestazione ---- */

    .mhxr-hero {
        text-align: center;
        margin-bottom: 28px;
    }

    .mhxr-kicker {
        display: inline-block;
        padding: 5px 14px;
        margin-bottom: 14px;
        background: rgba(139, 0, 0, 0.7);
        border: 1px solid rgba(212, 175, 55, 0.4);
        border-radius: 20px;
        color: #d4af37;
        font-size: 0.7rem;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .mhxr-title {
        margin: 0 0 10px;
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 2.4rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        /* Il bagliore dorato da solo si perdeva sulle parti chiare dello
           sfondo (fulmini/cielo): questa ombra scura scura sotto lo tiene
           leggibile ovunque la pagina scorra. */
        text-shadow: 0 0 28px rgba(255, 215, 0, 0.35), 0 2px 10px rgba(0, 0, 0, 0.95), 0 0 6px rgba(0, 0, 0, 0.95);
    }

    .mhxr-sub {
        margin: 0 auto;
        max-width: 480px;
        color: #d8d8d8;
        font-size: 0.95rem;
        line-height: 1.65;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.95), 0 0 4px rgba(0, 0, 0, 0.95);
    }

    /* ---- Striscia donazione ---- */

    .mhxr-donate {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 26px;
        padding: 16px 20px;
        background: linear-gradient(135deg, rgba(139, 0, 0, 0.6), rgba(13, 5, 0, 0.92));
        border: 1px solid rgba(212, 175, 55, 0.35);
        border-radius: 12px;
    }

    .mhxr-donate-icon {
        flex: 0 0 auto;
        font-size: 1.8rem;
        line-height: 1;
    }

    .mhxr-donate-text {
        flex: 1 1 auto;
        min-width: 0;
    }

    .mhxr-donate-title {
        margin: 0 0 3px;
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 0.95rem;
        letter-spacing: 1px;
    }

    .mhxr-donate-sub {
        margin: 0;
        color: #b0b0b0;
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .mhxr-donate-actions {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .mhxr-donate-btn {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 18px;
        background: #ffd700;
        border: 1px solid #ffd700;
        border-radius: 8px;
        color: #2a1500 !important;
        font-family: 'Cinzel', serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none !important;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .mhxr-donate-btn:hover {
        background: #fff0a0;
        box-shadow: 0 0 22px rgba(255, 215, 0, 0.45);
        transform: translateY(-1px);
    }

    /* Secondo modo di pagare: stessa forma del bottone PayPal, cosi' si
       capisce a colpo d'occhio che sono due alternative equivalenti, ma
       col riquadro invece del riempimento pieno per non farli sembrare
       la stessa identica azione. */
    .mhxr-donate-btn-alt {
        background: transparent;
        border: 1px solid #ffd700;
        color: #ffd700 !important;
    }

    .mhxr-donate-btn-alt:hover {
        background: rgba(255, 215, 0, 0.15);
        box-shadow: 0 0 22px rgba(255, 215, 0, 0.3);
    }

    /* ---- Scheda ticket ---- */

    .mhxr-card {
        background: rgba(10, 4, 0, 0.96);
        border: 1px solid rgba(212, 175, 55, 0.35);
        border-radius: 14px;
        padding: 30px 26px;
        box-shadow: 0 14px 46px rgba(0, 0, 0, 0.65);
    }

    .mhxr-card-title {
        margin: 0 0 6px;
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 1.35rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .mhxr-card-sub {
        margin: 0 0 24px;
        color: #a8a8a8;
        font-size: 0.87rem;
        line-height: 1.55;
    }

    .mhxr-label {
        display: block;
        margin-bottom: 8px;
        color: #d4af37;
        font-size: 0.76rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .mhxr-field {
        width: 100%;
        min-height: 52px;
        margin-bottom: 20px;
        padding: 13px 15px;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(212, 175, 55, 0.3);
        border-radius: 8px;
        color: #f0f0f0;
        /* 16px impedisce a iOS di ingrandire la pagina quando si tocca il campo */
        font-size: 16px;
        font-family: inherit;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .mhxr-field:focus {
        outline: none;
        border-color: #ffd700;
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.14);
    }

    .mhxr-field option {
        background: #0d0500;
        color: #f0f0f0;
    }

    .mhxr-textarea {
        min-height: 160px;
        margin-bottom: 6px;
        resize: vertical;
        line-height: 1.6;
    }

    .mhxr-counter {
        margin-bottom: 20px;
        color: #8a8a8a;
        font-size: 0.72rem;
        text-align: right;
    }

    .mhxr-counter-limite {
        color: #ff9c9c;
    }

    /* ---- Chi sei ---- */

    .mhxr-identita {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 22px;
        padding: 12px 15px;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(212, 175, 55, 0.18);
        border-radius: 8px;
        color: #b0b0b0;
        font-size: 0.82rem;
        line-height: 1.5;
    }

    .mhxr-identita-icona {
        flex: 0 0 auto;
        font-size: 1.1rem;
    }

    .mhxr-identita a {
        color: #d4af37;
        text-decoration: underline;
    }

    /* ---- Invio ---- */

    .mhxr-submit {
        width: 100%;
        min-height: 56px;
        background: linear-gradient(135deg, #8b0000, #b01818);
        border: 1px solid #ffd700;
        border-radius: 9px;
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.25s;
    }

    .mhxr-submit:hover:not(:disabled) {
        background: linear-gradient(135deg, #a81010, #d02020);
        box-shadow: 0 0 26px rgba(255, 215, 0, 0.35);
    }

    .mhxr-submit:disabled {
        opacity: 0.5;
        cursor: default;
    }

    .mhxr-msg {
        margin: 18px 0 0;
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 0.88rem;
        text-align: center;
        line-height: 1.55;
    }

    .mhxr-msg-errore {
        background: rgba(139, 0, 0, 0.22);
        border: 1px solid rgba(200, 40, 40, 0.5);
        color: #ff9c9c;
    }

    /* ---- Stato del ticket (chi e' loggato) ---- */

    .mhxr-status-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }

    .mhxr-status-id {
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 1.15rem;
        letter-spacing: 1px;
    }

    .mhxr-badge {
        display: inline-block;
        padding: 4px 13px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .mhxr-badge-pending {
        background: rgba(212, 175, 55, 0.2);
        border: 1px solid rgba(212, 175, 55, 0.5);
        color: #ffd700;
    }

    .mhxr-badge-progress {
        background: rgba(70, 130, 180, 0.22);
        border: 1px solid rgba(120, 170, 220, 0.5);
        color: #9ecbf0;
    }

    .mhxr-badge-answered {
        background: rgba(26, 127, 55, 0.25);
        border: 1px solid rgba(60, 180, 100, 0.5);
        color: #8fe6a8;
    }

    .mhxr-badge-closed {
        background: rgba(120, 120, 120, 0.2);
        border: 1px solid rgba(160, 160, 160, 0.35);
        color: #b0b0b0;
    }

    .mhxr-status-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px 16px;
        margin-bottom: 6px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    }

    .mhxr-status-meta-label {
        display: block;
        color: #8a8a8a;
        font-size: 0.7rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .mhxr-status-meta-value {
        color: #e0e0e0;
        font-size: 0.9rem;
    }

    .mhxr-convo-title {
        margin: 20px 0 14px;
        color: #d4af37;
        font-size: 0.78rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .mhxr-convo {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .mhxr-bubble {
        max-width: 92%;
        padding: 13px 16px;
        border-radius: 12px;
        font-size: 0.88rem;
        line-height: 1.6;
        white-space: pre-line;
    }

    .mhxr-bubble-user {
        align-self: flex-end;
        background: rgba(139, 0, 0, 0.28);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: #f5f0e6;
        border-bottom-right-radius: 3px;
    }

    .mhxr-bubble-staff {
        align-self: flex-start;
        background: rgba(212, 175, 55, 0.1);
        border: 1px solid rgba(212, 175, 55, 0.35);
        color: #fff3cc;
        border-bottom-left-radius: 3px;
    }

    .mhxr-bubble-meta {
        margin-top: 6px;
        color: #888;
        font-size: 0.7rem;
    }

    .mhxr-bubble-meta-user {
        text-align: right;
    }

    .mhxr-status-note {
        margin-top: 22px;
        padding: 13px 15px;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(212, 175, 55, 0.18);
        border-radius: 8px;
        color: #b0b0b0;
        font-size: 0.85rem;
        line-height: 1.55;
        text-align: center;
    }

    @@media (max-width: 600px) {
        .mhxr-wrap {
            padding: 28px 14px 50px;
        }

        .mhxr-title {
            font-size: 1.6rem;
            letter-spacing: 2px;
        }

        .mhxr-card {
            padding: 22px 17px;
            border-radius: 11px;
        }

        /* Su schermo stretto la striscia donazione va in colonna, altrimenti
           il bottone schiaccia il testo */
        .mhxr-donate {
            flex-direction: column;
            text-align: center;
            gap: 12px;
        }

        .mhxr-donate-actions {
            width: 100%;
        }

        .mhxr-donate-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="mhxr-wrap">

    <div class="mhxr-hero">
        <span class="mhxr-kicker">Private Server</span>
        <h1 class="mhxr-title">MHXR Feedback</h1>
        <p class="mhxr-sub">
            Found a bug, a crash, or a monster that should not be in that quest?
            Tell me here and I will look into it.
        </p>
    </div>

    @* La donazione sta sopra al modulo, come richiesto. E' volutamente una
       striscia bassa e non una scheda grande: chi arriva qui vuole segnalare
       un problema, il modulo deve restare la cosa principale. *@
    <div class="mhxr-donate">
        <span class="mhxr-donate-icon">🐉</span>
        <div class="mhxr-donate-text">
            <p class="mhxr-donate-title">Keep the server alive</p>
            <p class="mhxr-donate-sub">
                The MHXR server runs on my own hardware. Any help is welcome, 
                your report matters just as much!
            </p>
        </div>
        <div class="mhxr-donate-actions">
            <a class="mhxr-donate-btn"
               href="https://www.paypal.com/paypalme/heroic853"
               target="_blank"
               rel="noopener">
                💰 PayPal
            </a>
            <a class="mhxr-donate-btn mhxr-donate-btn-alt"
               href="https://buy.stripe.com/cNi8wP4Ki8250HYaYz8og00"
               target="_blank"
               rel="noopener">
                💳 Card
            </a>
        </div>
    </div>

    <div class="mhxr-card">

        @if (caricamentoIniziale)
        {
            <p class="mhxr-card-sub" style="text-align:center;margin:0;">Loading your ticket…</p>
        }
        else if (ticketAttivo is not null)
        {
            @* Sia chi e' loggato (letto dal token) sia chi non lo e' (letto dal
               "biglietto" in localStorage) finisce qui se ha gia' un ticket non
               ancora chiuso: e' cosi' che la pagina applica "un ticket alla
               volta", ed e' anche il posto dove si vede se/quando ho risposto. *@
            <div class="mhxr-status-head">
                <span class="mhxr-status-id">Ticket #@ticketAttivo.Id</span>
                <span class="mhxr-badge @ClasseStato(ticketAttivo.Stato)">@EtichettaStato(ticketAttivo.Stato)</span>
            </div>

            @if (ticketAttivoEAnonimo)
            {
                <p class="mhxr-status-note" style="margin-top:0;margin-bottom:18px;">
                    You sent this ticket anonymously 
                </p>
            }

            <div class="mhxr-status-meta">
                <div>
                    <span class="mhxr-status-meta-label">Type of issue</span>
                    <span class="mhxr-status-meta-value">@ticketAttivo.Categoria</span>
                </div>
                <div>
                    <span class="mhxr-status-meta-label">Sent on</span>
                    <span class="mhxr-status-meta-value">@ticketAttivo.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                </div>
            </div>

            <p class="mhxr-convo-title">Conversation</p>
            <div class="mhxr-convo">
                @foreach (var msg in ticketAttivo.Messaggi)
                {
                    var daTe = msg.Mittente == MhxrMittente.Utente;
                    <div>
                        <div class="mhxr-bubble @(daTe ? "mhxr-bubble-user" : "mhxr-bubble-staff")">@msg.Testo</div>
                        <div class="mhxr-bubble-meta @(daTe ? "mhxr-bubble-meta-user" : "")">
                            @(daTe ? "You" : "Heroic853"), @msg.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </div>
                    </div>
                }
            </div>

            <label class="mhxr-label" for="mhxr-newmsg">Add a message</label>
            <textarea id="mhxr-newmsg"
                      class="mhxr-field mhxr-textarea"
                      style="min-height:90px;"
                      maxlength="4000"
                      placeholder="Add more details, or answer a question..."
                      @bind="nuovoMessaggio"
                      @bind:event="oninput"></textarea>

            <button class="mhxr-submit" @onclick="InviaMessaggio" disabled="@(invioMessaggioInCorso || string.IsNullOrWhiteSpace(nuovoMessaggio))">
                @(invioMessaggioInCorso ? "Sending..." : "Send message")
            </button>
        }
        else
        {
            <h2 class="mhxr-card-title">Open a ticket</h2>
            <p class="mhxr-card-sub">
                Pick what kind of problem it is, then describe it. The more detail
                you give (quest name, monster, what you were doing), the faster I can fix it.
            </p>

            <label class="mhxr-label" for="mhxr-cat">Type of issue</label>
            <select id="mhxr-cat" class="mhxr-field" @bind="categoria">
                <option value="">— choose a category —</option>
                @foreach (var cat in MhxrTicketCategorie.Tutte)
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <label class="mhxr-label" for="mhxr-msg">Describe the problem</label>
            <textarea id="mhxr-msg"
                      class="mhxr-field mhxr-textarea"
                      rows="7"
                      maxlength="4000"
                      placeholder="What happened? Where?"
                      @bind="messaggio"
                      @bind:event="oninput"></textarea>

            <div class="mhxr-counter @(LunghezzaMessaggio > 3800 ? "mhxr-counter-limite" : "")">
                @LunghezzaMessaggio / 4000
            </div>

            <label class="mhxr-label" for="mhxr-nome">Your name or account (optional)</label>
            <input id="mhxr-nome"
                   class="mhxr-field"
                   type="text"
                   maxlength="60"
                   placeholder="So I know who's writing — not required"
                   @bind="nomeAnonimo"
                   @bind:event="oninput" />

            <button class="mhxr-submit" @onclick="InviaTicket" disabled="@invioInCorso">
                @(invioInCorso ? "Sending..." : "Send ticket")
            </button>

            @if (!string.IsNullOrEmpty(errore))
            {
                <p class="mhxr-msg mhxr-msg-errore">@errore</p>
            }
        }

    </div>
</div>
