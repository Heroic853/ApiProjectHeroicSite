@page "/MessageOfGratitude"

<style>
    body {
        background-image: url('images/RedWallpaper.webp');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: top center;
        background-attachment: fixed;
        background-color: #0a0500;
        min-height: 100vh;
        margin: 0;
    }

    .archive-wrapper {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 20px 120px;
        gap: 0;
        max-width: 1100px;
        margin: 0 auto;
    }

    .parchment {
        flex: 1;
        background: linear-gradient(160deg, #c8aa78 0%, #d4b882 20%, #c0a06a 40%, #cdb07a 60%, #b89460 80%, #c4a472 100%);
        border: 4px solid #6b4520;
        border-radius: 4px;
        box-shadow: 0 0 0 1px #8b5e30, 0 0 60px rgba(0,0,0,0.7), inset 0 0 40px rgba(80,40,10,0.2);
        position: relative;
        padding: 0 0 60px;
        min-width: 0;
    }

    .parchment::before {
        content: '';
        position: absolute;
        inset: -2px;
        background: radial-gradient(ellipse at 0% 0%, rgba(80,40,0,0.4) 0%, transparent 30%), radial-gradient(ellipse at 100% 0%, rgba(80,40,0,0.4) 0%, transparent 30%), radial-gradient(ellipse at 0% 100%, rgba(80,40,0,0.4) 0%, transparent 30%), radial-gradient(ellipse at 100% 100%, rgba(80,40,0,0.4) 0%, transparent 30%);
        pointer-events: none;
        border-radius: 4px;
        z-index: 1;
    }

    .parchment-header {
        text-align: center;
        padding: 50px 60px 30px;
        border-bottom: 2px solid rgba(80,40,10,0.3);
    }

    .parchment-title {
        font-family: 'Cinzel', serif;
        font-size: 2.4rem;
        font-weight: 700;
        color: #3b2008;
        letter-spacing: 5px;
        text-transform: uppercase;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.3);
        margin: 0 0 20px;
    }

    .parchment-intro {
        font-family: 'Georgia', serif;
        font-size: 1rem;
        line-height: 1.9;
        color: #2c1a08;
        font-style: italic;
        max-width: 600px;
        margin: 0 auto;
    }

    .year-section {
        padding: 40px 50px;
        border-bottom: 1px solid rgba(80,40,10,0.2);
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .year-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .year-section:last-child {
        border-bottom: none;
    }

    .year-label {
        font-family: 'Cinzel', serif;
        font-size: 3rem;
        font-weight: 700;
        color: #3b2008;
        letter-spacing: 8px;
        margin: 0 0 6px;
        line-height: 1;
        text-shadow: 1px 1px 0 rgba(255,255,255,0.4);
    }

    .year-subtitle {
        font-family: 'Georgia', serif;
        font-size: 0.82rem;
        color: #7a5030;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .year-divider {
        width: 100%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(80,40,10,0.5), transparent);
        margin-bottom: 24px;
    }

    /* ── Featured image box (optional per year) ── */
    .img-box {
        width: 100%;
        height: 300px;
        border: 2px solid rgba(80,40,10,0.4);
        border-radius: 2px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(80,40,10,0.08);
        overflow: hidden;
    }

    .img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .img-box-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: rgba(80,40,10,0.35);
        font-family: 'Cinzel', serif;
        font-size: 0.75rem;
        letter-spacing: 2px;
    }

    /* ── Mod list ── */
    .mod-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .mod-entry {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 18px 0;
        border-bottom: 1px solid rgba(80,40,10,0.12);
        opacity: 0;
        transform: translateX(-16px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .mod-entry.visible {
        opacity: 1;
        transform: translateX(0);
    }

    .mod-entry:last-child {
        border-bottom: none;
    }

    .mod-info {
        flex: 1;
    }

    /* ── Mod image inside card ── */
    .mod-img {
        width: 100%;
        max-height: 380px;
        object-fit: cover;
        border-radius: 4px;
        border: 3px solid #6b4520;
        outline: 1px solid #8b5e30;
        margin-bottom: 14px;
        display: block;
        box-shadow: 0 0 0 6px rgba(80,40,10,0.12), 0 8px 24px rgba(0,0,0,0.4);
    }

    /* ── Mod name — big, red/orange ── */
    .mod-name {
        font-family: 'Cinzel', serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: #a03000;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 6px;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.25);
        line-height: 1.3;
    }

    .mod-desc {
        font-family: 'Georgia', serif;
        font-size: 0.88rem;
        color: #5a3820;
        line-height: 1.7;
        font-style: italic;
        margin-bottom: 8px;
    }

    .mod-link {
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        padding: 8px 20px;
        background: linear-gradient(135deg, #6b2000, #4a1500);
        border: 2px solid #8b3000;
        border-radius: 6px;
        font-family: 'Cinzel', serif;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #d4a060 !important;
        text-decoration: none !important;
        transition: all 0.2s;
    }

    .mod-link::before {
        content: '↗';
    }

    .mod-link:hover {
        background: linear-gradient(135deg, #8b3000, #6b2000);
        color: #f0c080 !important;
        box-shadow: 0 0 14px rgba(139,48,0,0.5);
        transform: translateY(-1px);
    }

    .parchment-footer {
        text-align: center;
        padding: 24px 40px;
        color: rgba(59,32,8,0.45);
        font-family: 'Georgia', serif;
        font-size: 0.82rem;
        font-style: italic;
    }

    .mod-entry.special {
        border: 2px solid #ffd700;
        box-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
        transform: scale(1.03);
    }

    .mod-entry.special::before {
        content: '★ EXPANSION';
        position: absolute;
        top: -10px;
        left: 16px;
        background: linear-gradient(90deg, #8b3000, #a04000);
        color: #f0c080;
        font-family: 'Cinzel', serif;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 3px;
        padding: 3px 12px;
        border-radius: 3px;
        border: 1px solid #c06020;
    }

    .mod-entry.special .mod-name {
        color: yellow;
        font-size: 1.50rem;
    }

    @@media (max-width: 768px) {
        .archive-wrapper {
            padding: 20px 12px 80px;
        }

        .parchment-title {
            font-size: 1.5rem;
        }

        .year-label {
            font-size: 2rem;
        }

        .year-section {
            padding: 24px 20px;
        }

        .parchment-header {
            padding: 28px 20px 18px;
        }

        .img-box {
            height: 180px;
        }

        .mod-name {
            font-size: 1rem;
        }
    }
</style>

<div class="archive-wrapper">
