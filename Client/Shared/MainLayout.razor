@* ---- Conferma di uscita ----
   Un modale del sito invece del confirm() del browser: si vede uguale su
   telefono e desktop, e non si puo' bloccare come i popup nativi. *@
@if (confermaUscita)
{
    <div class="logout-overlay" @onclick="AnnullaUscita">
        <div class="logout-box" @onclick:stopPropagation="true">
            <h2 class="logout-title">Leaving already?</h2>
            <p class="logout-text">
                Are you sure you want to sign out?<br />
                You will need to sign in again to leave ratings or reach your settings.
            </p>
            <div class="logout-actions">
                <button class="logout-btn logout-btn-cancel" @onclick="AnnullaUscita">
                    Stay
                </button>
                <button class="logout-btn logout-btn-confirm" @onclick="ConfermaUscita">
                    Sign Out
                </button>
            </div>
        </div>
    </div>
}

@code {
    bool menuOpen = false;

    // Tendina sotto il nome utente e modale di conferma uscita
    bool userMenuOpen = false;
    bool confermaUscita = false;

    void ToggleMenu()
    {
        menuOpen = !menuOpen;
        // Chiudendo il drawer si chiude anche la tendina, altrimenti
        // riaprendolo la ritrovi aperta da prima
        if (!menuOpen) userMenuOpen = false;
    }

    void CloseMenu()
    {
        menuOpen = false;
        userMenuOpen = false;
    }

    void ToggleMenuUtente() => userMenuOpen = !userMenuOpen;

    void ChiudiMenuUtente() => userMenuOpen = false;

    /// <summary>Sul telefono, aprire una voce chiude anche il drawer.</summary>
    void ChiudiMenuEDrawer()
    {
        userMenuOpen = false;
        menuOpen = false;
    }

    void ChiediConfermaUscita()
    {
        userMenuOpen = false;
        confermaUscita = true;
    }

    void AnnullaUscita() => confermaUscita = false;

    void ConfermaUscita()
    {
        confermaUscita = false;
        menuOpen = false;
        SignOut();
    }

    /// <summary>
    /// Nome da mostrare nel chip. L'email intera e' troppo lunga per la barra:
    /// mostra solo la parte prima della chiocciola.
    /// </summary>
    static string NomeUtente(System.Security.Claims.ClaimsPrincipal user)
    {
        var email = user.FindFirst("email")?.Value;
        if (string.IsNullOrWhiteSpace(email))
            return user.Identity?.Name ?? "Hunter";

        var chiocciola = email.IndexOf('@');
        return chiocciola > 0 ? email[..chiocciola] : email;
    }

    // Era "async void" e chiamava una funzione JS "forceLogout" che non esiste
    // in nessun file del progetto: il bottone Sign Out lanciava un errore JS
    // silenzioso e non faceva assolutamente niente.
    //
    // NavigateToLogout avvia il logout gestito da Blazor: pulisce il token
    // locale, e poi Authentication.razor chiude anche la sessione su Auth0
    // (altrimenti il cookie SSO di Auth0 resta valido e al login successivo
    // rientri senza che ti chieda le credenziali).
    void SignOut()
    {
        menuOpen = false;
        NavManager.NavigateToLogout("authentication/logout");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Una sola visita per sessione di navigazione.
            //
            // Serve per il 404.html di GitHub Pages: durante il tentativo di
            // login silenzioso Auth0 rimanda a /authentication/login-callback,
            // che su Pages non esiste come file, quindi risponde il 404.html che
            // fa location.replace(). Quello e' un RICARICAMENTO COMPLETO: l'app
            // Blazor riparte da zero e OnInitializedAsync viene eseguito una
            // seconda volta, contando due volte la stessa visita.
            //
            // sessionStorage sopravvive al ricaricamento ma non alla chiusura
            // della tab, che e' esattamente il comportamento che vogliamo.
            var giaContata = await JSRuntime.InvokeAsync<string?>(
                "sessionStorage.getItem", "heroic-visita-contata");

            if (!string.IsNullOrEmpty(giaContata))
                return;

            // Il flag va scritto PRIMA della chiamata: se lo scrivessimo dopo,
            // un secondo giro partito nel frattempo conterebbe di nuovo.
            await JSRuntime.InvokeVoidAsync(
                "sessionStorage.setItem", "heroic-visita-contata", "1");

            // IMPORTANTE: qui va il client "Anonymous".
            // Prima usava "Http" (quello con il token Auth0): per un visitatore
            // non loggato l'AuthorizationMessageHandler lanciava
            // AccessTokenNotAvailableException, il catch la ingoiava, e la
            // richiesta non usciva nemmeno dal browser. Risultato: il grafico
            // admin contava solo gli utenti loggati, cioe' quasi nessuno.
            var anonClient = HttpClientFactory.CreateClient("Anonymous");
            await anonClient.PostAsync("api/dragon/log-visit", null);
        }
        catch (Exception ex)
        {
            // Il conteggio visite non deve mai rompere il sito, ma almeno
            // lascia traccia nella console del browser.
            Console.WriteLine($"[log-visit] non riuscito: {ex.Message}");
        }
    }
}
