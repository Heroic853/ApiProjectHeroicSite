@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject IHttpClientFactory HttpClientFactory

<style>

    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        width: 100%;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    /* ── Layout ── */
    .layout-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .page-content {
        flex: 1;
        padding: 30px 20px;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
    }

    /* navbar */
    .topnav {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #0d0905;
        border-bottom: 2px solid #8b0000;
        box-shadow: 0 2px 20px rgba(139, 0, 0, 0.4);
    }

    .topnav-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
        height: 56px;
    }

    /* ── Logo ── */
    .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none !important;
        flex-shrink: 0;
    }

    .nav-logo img {
        border-radius: 6px;
        border: 1px solid #8b0000;
    }

    .nav-logo-text {
        font-family: 'Cinzel', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #d4af37;
        letter-spacing: 2px;
        text-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
    }

    .logo-accent {
        color: #ff3333;
    }

    /* ── Nav links (desktop) ── */
    .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1;
    }

    .nav-links li a,
    .nav-links li .nav-link {
        display: block;
        padding: 6px 12px;
        font-family: 'Cinzel', serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #a0a0a0 !important;
        text-decoration: none !important;
        border-radius: 4px;
        transition: color 0.2s, background 0.2s;
        white-space: nowrap;
    }

    .nav-links li a:hover,
    .nav-links li .nav-link:hover {
        color: #d4af37 !important;
        background: rgba(212, 175, 55, 0.08);
    }

    .nav-links li a.active,
    .nav-links li .nav-link.active {
        color: #d4af37 !important;
        background: rgba(139, 0, 0, 0.4);
        border-bottom: 2px solid #d4af37;
    }

    /* ── Auth zone ── */
    .nav-auth {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-shrink: 0;
    }

    .nav-user-zone {
        display: flex;
        align-items: center;
        gap: 8px;
        /* riferimento per posizionare la tendina sotto al nome */
        position: relative;
    }

    /* ---- Tendina utente ------------------------------------------------
       Prima il nome era un link diretto al profilo e accanto c'era una X
       che faceva logout immediato, senza chiedere niente. */

    .user-caret {
        margin-left: 2px;
        color: #d4af37;
        font-size: 0.6rem;
        transition: transform 0.2s;
    }

    .user-caret-open {
        transform: rotate(180deg);
    }

    /* Fondale invisibile: cliccando fuori la tendina si chiude, senza
       bisogno di JavaScript per intercettare il click esterno. */
    .user-menu-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2500;
        background: transparent;
        border: none;
        padding: 0;
        cursor: default;
    }

    .user-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        z-index: 2600;
        min-width: 210px;
        padding: 8px;
        background: #160a03;
        border: 1px solid rgba(212, 175, 55, 0.4);
        border-radius: 10px;
        box-shadow: 0 12px 34px rgba(0, 0, 0, 0.75);
        animation: userMenuIn 0.16s ease;
    }

    @@keyframes userMenuIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .user-menu-header {
        padding: 8px 12px 10px;
        border-bottom: 1px solid rgba(212, 175, 55, 0.18);
        margin-bottom: 6px;
        color: #8a8a8a;
        font-size: 0.72rem;
        word-break: break-all;
    }

    .user-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        /* 46px: sopra la soglia dei 44px, cosi' funziona anche col dito */
        min-height: 46px;
        padding: 0 12px;
        background: transparent;
        border: none;
        border-radius: 7px;
        color: #e8e8e8;
        font-family: inherit;
        font-size: 0.88rem;
        text-align: left;
        text-decoration: none !important;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }

    .user-menu-item:hover {
        background: rgba(139, 0, 0, 0.45);
        color: #ffd700;
    }

    .user-menu-item-danger:hover {
        background: rgba(139, 0, 0, 0.6);
        color: #ff9c9c;
    }

    .user-menu-sep {
        height: 1px;
        margin: 6px 8px;
        background: rgba(212, 175, 55, 0.18);
    }

    /* ---- Conferma di uscita ----
       Un modale del sito invece del confirm() grigio del browser, cosi' e'
       uguale su telefono e su desktop. */

    .logout-overlay {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.8);
        animation: userMenuIn 0.18s ease;
    }

    .logout-box {
        width: 100%;
        max-width: 400px;
        padding: 28px 24px;
        background: #160a03;
        border: 1px solid rgba(212, 175, 55, 0.45);
        border-radius: 12px;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.85);
        text-align: center;
    }

    .logout-title {
        margin: 0 0 10px;
        color: #ffd700;
        font-family: 'Cinzel', serif;
        font-size: 1.25rem;
        letter-spacing: 1px;
    }

    .logout-text {
        margin: 0 0 24px;
        color: #c0c0c0;
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .logout-actions {
        display: flex;
        gap: 12px;
    }

    .logout-btn {
        flex: 1;
        min-height: 48px;
        border-radius: 8px;
        font-family: 'Cinzel', serif;
        font-size: 0.88rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s;
    }

    .logout-btn-cancel {
        background: transparent;
        border: 1px solid rgba(212, 175, 55, 0.45);
        color: #d4af37;
    }

    .logout-btn-cancel:hover {
        background: rgba(212, 175, 55, 0.12);
    }

    .logout-btn-confirm {
        background: linear-gradient(135deg, #8b0000, #b01818);
        border: 1px solid #ffd700;
        color: #ffd700;
        font-weight: bold;
    }

    .logout-btn-confirm:hover {
        background: linear-gradient(135deg, #a81010, #d02020);
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
    }

    @@media (max-width: 520px) {
        .logout-actions {
            flex-direction: column-reverse;
        }
    }

    .nav-user-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 12px;
        background: rgba(139, 0, 0, 0.3);
        border: 1px solid #8b0000;
        border-radius: 20px;
        text-decoration: none !important;
        transition: all 0.2s;
    }

    .nav-user-chip:hover {
        background: rgba(139, 0, 0, 0.55);
        border-color: #d4af37;
        box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
    }

    .user-icon {
        font-size: 0.9rem;
    }

    .user-email {
        font-family: 'Cinzel', serif;
        font-size: 0.68rem;
        color: #c0c0c0;
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .footer-socials {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-bottom: 12px;
    }

    .footer-social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #3a1a1a;
        background: rgba(139, 0, 0, 0.15);
        color: #888;
        transition: all 0.25s;
        text-decoration: none !important;
    }

    .footer-social-link:hover {
        border-color: #d4af37;
        background: rgba(139, 0, 0, 0.4);
        color: #d4af37;
        box-shadow: 0 0 12px rgba(212, 175, 55, 0.35);
        transform: translateY(-2px);
    }

    .footer-social-link svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    .nav-signout-btn {
        background: rgba(139, 0, 0, 0.4);
        border: 1px solid #8b0000;
        color: #ff6b6b;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nav-signout-btn:hover {
        background: rgba(200, 0, 0, 0.6);
        color: #fff;
        border-color: #ff0000;
    }

    .nav-signin-btn {
        padding: 7px 18px;
        background: #8b0000;
        border: 1px solid #d4af37;
        border-radius: 5px;
        font-family: 'Cinzel', serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #d4af37 !important;
        text-decoration: none !important;
        transition: all 0.2s;
    }

    .nav-signin-btn:hover {
        background: #a01010;
        box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
        color: #ffd700 !important;
    }

    .hamburger {
        display: none;
        background: #8b0000;
        border: 1px solid #d4af37;
        border-radius: 6px;
        color: #d4af37;
        width: 38px;
        height: 38px;
        font-size: 1.1rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        padding: 0;
    }

    .hamburger:hover {
        background: #a01010;
        box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
    }

    .ham-icon {
        line-height: 1;
    }

    .mobile-drawer {
        background: #0d0905;
        border-top: 1px solid #8b0000;
        padding: 16px 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* Da div e' diventato un bottone per aprire la tendina: serve larghezza
       piena e cursore a manina.
       NB: mai scrivere nomi di tag tra parentesi angolari nei commenti CSS
       di un file .razor: Razor li legge come tag HTML veri e il build
       fallisce con "Unclosed tag". */
    .drawer-user {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        min-height: 48px;
        padding: 10px 14px;
        background: rgba(139, 0, 0, 0.3);
        border: 1px solid #8b0000;
        border-radius: 8px;
        color: inherit;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
    }

    .drawer-user .user-caret {
        margin-left: auto;
    }

    /* La tendina nel drawer non e' sovrapposta: si espande in linea, cosi'
       su schermi piccoli non finisce mai fuori dal bordo. */
    .drawer-user-menu {
        margin-top: 8px;
        padding: 6px;
        background: rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(212, 175, 55, 0.25);
        border-radius: 8px;
    }

    .drawer-user-icon {
        font-size: 1.1rem;
    }

    .drawer-user-email {
        font-family: 'Cinzel', serif;
        font-size: 0.75rem;
        color: #c0c0c0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .drawer-links {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .drawer-links li a,
    .drawer-links li .nav-link {
        display: block;
        padding: 11px 16px;
        font-family: 'Cinzel', serif;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #a0a0a0 !important;
        text-decoration: none !important;
        border: 1px solid transparent;
        border-radius: 5px;
        transition: all 0.2s;
    }

    .drawer-links li a:hover,
    .drawer-links li .nav-link:hover,
    .drawer-links li a.active,
    .drawer-links li .nav-link.active {
        color: #d4af37 !important;
        background: rgba(139, 0, 0, 0.35);
        border-color: #8b0000;
    }

    .drawer-signout {
        margin-top: 4px;
        padding: 11px;
        background: rgba(139, 0, 0, 0.3);
        border: 1px solid #8b0000;
        border-radius: 5px;
        font-family: 'Cinzel', serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #ff6b6b;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }

    .drawer-signout:hover {
        background: rgba(200, 0, 0, 0.5);
        border-color: #ff0000;
        color: #fff;
    }

    .drawer-signin {
        display: block;
        padding: 12px;
        background: #8b0000;
        border: 1px solid #d4af37;
        border-radius: 5px;
        font-family: 'Cinzel', serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #d4af37 !important;
        text-decoration: none !important;
        text-align: center;
        transition: all 0.2s;
    }

    .drawer-signin:hover {
        background: #a01010;
        color: #ffd700 !important;
    }

    /* ── Footer ── */
    .site-footer {
        text-align: center;
        padding: 16px;
        color: white;
        font-family: 'Cinzel', serif;
        font-size: 0.75rem;
        letter-spacing: 1px;
        background: black;
    }

    @@media (max-width: 900px) {
        .nav-links {
            display: none;
        }

        .hamburger {
            display: flex;
        }

        .nav-user-chip .user-email {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .nav-logo-text {
            display: none;
        }

        .nav-user-chip {
            padding: 5px 8px;
        }
    }
</style>
<div class="layout-wrapper">
    <nav class="topnav">
        <div class="topnav-inner">

            <!-- LEFT: Logo -->
            <a href="" class="nav-logo">
                <img src="images/Heroic853Icon.webp" width="38" height="38" alt="Heroic853" />
                <span class="nav-logo-text">Nemesis Heroic</span>
            </a>

            <!-- CENTER: Nav links (desktop) -->
            <AuthorizeView>
                <Authorized>
                    <ul class="nav-links" id="nav-links">
                        <li><NavLink href="" Match="NavLinkMatch.All">Introduction</NavLink></li>
                        <li><NavLink href="commissions">Commissions</NavLink></li>
                        <li><NavLink href="MessageOfGratitude">Mod History</NavLink></li>
                        <li><NavLink href="newmods">Updates Mods</NavLink></li>
                        <li><NavLink href="thedemonprincemods">The Demon Prince Mods</NavLink></li>
                        <li><NavLink href="videopage">Special Videos</NavLink></li>
                        <li><NavLink href="musicproj">Soundtrack</NavLink></li>
                        <li><NavLink href="forbiddenMonsters">Forbidden Monsters</NavLink></li>
                        <li><NavLink href="dragonList">Monster Choice</NavLink></li>
                        @if (context.User.IsInRole("Admin"))
                        {
                            <li><NavLink href="aniversarytable">⚙ Admin</NavLink></li>
                        }
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="nav-links" id="nav-links">
                        <li><NavLink href="" Match="NavLinkMatch.All">Introduction</NavLink></li>
                        <li><NavLink href="commissions">Commissions</NavLink></li>
                        <li><NavLink href="MessageOfGratitude">Mod History</NavLink></li>
                        <li><NavLink href="newmods">Updates Mods</NavLink></li>
                        <li><NavLink href="thedemonprincemods">The Demon Prince Mods</NavLink></li>
                        <li><NavLink href="videopage">Special Videos</NavLink></li>
                        <li><NavLink href="musicproj">Soundtrack</NavLink></li>
                        <li><NavLink href="forbiddenMonsters">Forbidden Monsters</NavLink></li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>

            <!-- Auth zone -->
            <div class="nav-auth">
                <AuthorizeView>
                    <Authorized>
                        @* Il fondale sta PRIMA della tendina e copre tutto lo
                           schermo: un click fuori la chiude. *@
                        @if (userMenuOpen)
                        {
                            <button class="user-menu-backdrop"
                                    aria-label="Close menu"
                                    @onclick="ChiudiMenuUtente"></button>
                        }

                        <div class="nav-user-zone">
                            <button class="nav-user-chip"
                                    @onclick="ToggleMenuUtente"
                                    aria-haspopup="true"
                                    aria-expanded="@userMenuOpen"
                                    title="Account">
                                <span class="user-icon">⚔️</span>
                                <span class="user-email">@NomeUtente(context.User)</span>
                                <span class="user-caret @(userMenuOpen ? "user-caret-open" : "")">▼</span>
                            </button>

                            @if (userMenuOpen)
                            {
                                <div class="user-menu">
                                    <div class="user-menu-header">
                                        @(context.User.FindFirst("email")?.Value ?? "Signed in")
                                    </div>

                                    <NavLink href="UserProfile"
                                             class="user-menu-item"
                                             @onclick="ChiudiMenuUtente">
                                        <span>⚙</span><span>Settings</span>
                                    </NavLink>

                                    @if (context.User.IsInRole("Admin"))
                                    {
                                        <NavLink href="aniversarytable"
                                                 class="user-menu-item"
                                                 @onclick="ChiudiMenuUtente">
                                            <span>📊</span><span>Admin</span>
                                        </NavLink>
                                    }

                                    <div class="user-menu-sep"></div>

                                    <button class="user-menu-item user-menu-item-danger"
                                            @onclick="ChiediConfermaUscita">
                                        <span>⏻</span><span>Sign Out</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="authentication/login" class="nav-signin-btn">Sign In</NavLink>
                    </NotAuthorized>
                </AuthorizeView>

                <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
                    @if (menuOpen)
                    {
                        <span class="ham-icon">✕</span>
                    }
                    else
                    {
                        <span class="ham-icon">☰</span>
                    }
                </button>
            </div>
        </div>

        <!-- MOBILE DRAWER -->
        @if (menuOpen)
        {
            <div class="mobile-drawer">
                <AuthorizeView>
                    <Authorized>
                        @* Anche sul telefono il nome apre la tendina, con le
                           stesse voci del desktop: cliccandolo si espandono
                           Settings e Sign Out. *@
                        <button class="drawer-user" @onclick="ToggleMenuUtente">
                            <span class="drawer-user-icon">⚔️</span>
                            <span class="drawer-user-email">@context.User.FindFirst("email")?.Value</span>
                            <span class="user-caret @(userMenuOpen ? "user-caret-open" : "")">▼</span>
                        </button>

                        @if (userMenuOpen)
                        {
                            <div class="drawer-user-menu">
                                <NavLink href="UserProfile"
                                         class="user-menu-item"
                                         @onclick="ChiudiMenuEDrawer">
                                    <span>⚙</span><span>Settings</span>
                                </NavLink>

                                @if (context.User.IsInRole("Admin"))
                                {
                                    <NavLink href="aniversarytable"
                                             class="user-menu-item"
                                             @onclick="ChiudiMenuEDrawer">
                                        <span>📊</span><span>Admin</span>
                                    </NavLink>
                                }

                                <div class="user-menu-sep"></div>

                                <button class="user-menu-item user-menu-item-danger"
                                        @onclick="ChiediConfermaUscita">
                                    <span>⏻</span><span>Sign Out</span>
                                </button>
                            </div>
                        }
                        <ul class="drawer-links">
                            <li><NavLink href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Introduction</NavLink></li>
                            <li><NavLink href="commissions" @onclick="CloseMenu">Commissions</NavLink></li>
                            <li><NavLink href="MessageOfGratitude" @onclick="CloseMenu">Mod History</NavLink></li>
                            <li><NavLink href="newmods" @onclick="CloseMenu">Updates Mods</NavLink></li>
                            <li><NavLink href="thedemonprincemods" @onclick="CloseMenu">The Demon Prince Mods</NavLink></li>
                            <li><NavLink href="videopage" @onclick="CloseMenu">Special Videos</NavLink></li>
                            <li><NavLink href="musicproj" @onclick="CloseMenu">Soundtrack</NavLink></li>
                            <li><NavLink href="forbiddenMonsters" @onclick="CloseMenu">Forbidden Monsters</NavLink></li>
                            <li><NavLink href="dragonList" @onclick="CloseMenu">Monster Choice</NavLink></li>
                            @if (context.User.IsInRole("Admin"))
                            {
                                <li><NavLink href="aniversarytable" @onclick="CloseMenu">⚙ Admin</NavLink></li>
                            }
                        </ul>
                        @* Settings e Sign Out sono nella tendina sotto il nome,
                           qui erano duplicati. *@
                    </Authorized>
                    <NotAuthorized>
                        <ul class="drawer-links">
                            <li><NavLink href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Introduction</NavLink></li>
                            <li><NavLink href="commissions" @onclick="CloseMenu">Commissions</NavLink></li>
                            <li><NavLink href="MessageOfGratitude" @onclick="CloseMenu">Mod History</NavLink></li>
                            <li><NavLink href="newmods" @onclick="CloseMenu">Updates Mods</NavLink></li>
                            <li><NavLink href="thedemonprincemods" @onclick="CloseMenu">The Demon Prince Mods</NavLink></li>
                            <li><NavLink href="videopage" @onclick="CloseMenu">Special Videos</NavLink></li>
